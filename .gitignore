# ============================================================
# 2026 研究生数学建模 E 题 —— Git 忽略规则
# 目标：上传「代码 + 全部派生产物」（约 74 MB）；
#       排除「赛题原始题包」（约 4.0 GB，GitHub 单文件硬限 100 MB，传不上去，
#       且竞赛规则要求以赛题提供的数据为唯一来源，不应再分发）。
# ============================================================

# ---------- 1. 赛题原始题包（体量过大，务必排除）----------
# 附件1~4 原始压缩包：1.8 GB，内含 aligned_50.pkl(994MB) / unaligned_50.pkl(2.9GB)
data/attachment1.zip

# A~F 六套赛题原始压缩包：合计 2.2 GB（仅 E 题相关）
中文题目/
中文题目/*.zip

# 解压后的附件目录（若已解压，同样不传；体积约 5.8 GB）
data/attachment1/
data/temp_audio/

# ---------- 2. Office 锁文件（不是数据）----------
# Word/WPS 打开文档时生成的临时锁文件
~$*.docx
~$*.xlsx
~$*.md
~$*.pptx

# ---------- 3. Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ---------- 4. 本机 Claude Code 会话配置（机器本地，非项目内容）----------
.claude/settings.local.json
**/.claude/settings.local.json

# ---------- 5. 临时与一次性产物 ----------
# 小批量验证的临时产物（README 标明「可删」）
data/_tmp_textcheck/
# 一次性恢复脚本的临时输出
*.tmp
*.bak

# ---------- 6. 环境与编辑器 ----------
.venv/
venv/
env/
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---------- 7. 日志（保留目录内现有的，忽略新增滚动日志）----------
*.log.1
*.log.*
